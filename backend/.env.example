# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/wedding_emma_jose?schema=public"

# Server
PORT=4000
NODE_ENV=development

# JWT
JWT_SECRET="change-this-to-a-long-random-string"
